# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests/visual/.artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets (.env, .env.local, .env.production, etc.)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.codebase-memory/

# isolated worker package
workers/**/node_modules/
workers/**/.wrangler/
workers/**/.dev.vars

# ── stray artifacts — anything here lands in public/ and is served ───────────
# A backup resume dropped in public/ is publicly fetchable at its filename.
# Keep resume.pdf itself tracked; ignore every dated/backup variant.
public/resume*.bak.pdf
public/resume.20*.pdf
# Tool caches and unreferenced assets (not wired into any component)
.firecrawl/
public/textures/
